# Shared defaults
OUTPUT_ROOT=./outputs
BATCH_ID=demo_001
COMFYUI_URL=http://127.0.0.1:8188
DASHBOARD_HOST=127.0.0.1

# Optional per-route overrides
# FLUX_COMFYUI_URL=http://127.0.0.1:8188
# QWEN_COMFYUI_URL=http://127.0.0.1:8188
# FLUX_DASHBOARD_PORT=9000
# QWEN_DASHBOARD_PORT=9001

# CG exporter runtime overrides
# NODE_BIN=/absolute/path/to/node
# CDP_ENDPOINT=http://127.0.0.1:9222
# CG_PORT_BASE=5601

# ComfyUI launcher settings (GPU selection is supplied by the deployment shell)
# COMFYUI_ROOT=/absolute/path/to/ComfyUI
# COMFYUI_HOST=127.0.0.1
# COMFYUI_PORT=8188
